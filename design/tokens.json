{
  "$description": "zvx.nz design tokens; see AGENT_STYLE_GUIDE.md (W3C Design Tokens format). Generate platform code from this file; never hand-copy values. Sizes are in px at 1x (1rem = 16px).",
  "color": {
    "$type": "color",
    "black": {
      "$value": "#000000",
      "$description": "Page and panel fill (21:1 under text)"
    },
    "line": {
      "$value": "#2c2c2c",
      "$description": "1px rules and panel edges"
    },
    "muted": {
      "$value": "#8f8f8f",
      "$description": "Labels and secondary text (6.5:1 on black)"
    },
    "text": {
      "$value": "#f2f2f2",
      "$description": "Primary text (18.8:1 on black)"
    },
    "beak": {
      "$value": "#db7700",
      "$description": "The single accent, at most 5% of any view at rest (6.7:1 on black). Use black text on beak fills"
    },
    "field": {
      "rest": {
        "$value": "#2c2c2c",
        "$description": "Idle field cells and the static pattern. Never text"
      },
      "node": {
        "$value": "#4d4d4d",
        "$description": "Every eighth cell. Never text"
      },
      "low": {
        "$value": "#4d4d4d",
        "$description": "Ripple, low. Never text"
      },
      "mid": {
        "$value": "#8f8f8f",
        "$description": "Ripple, middle. Never text"
      },
      "high": {
        "$value": "#f2f2f2",
        "$description": "Ripple, high. Never text"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Geist"
        ],
        "$description": "brand/fonts/Geist-SemiBold.ttf (weight 600) for headings"
      },
      "body": {
        "$value": [
          "Geist"
        ],
        "$description": "brand/fonts/Geist-Regular.ttf (weight 400). Long-form text"
      },
      "mono": {
        "$value": [
          "Geist Mono"
        ],
        "$description": "brand/fonts/GeistMono-Regular.ttf. Labels, UI and data"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "semibold": {
        "$value": 600
      }
    }
  },
  "typography": {
    "$type": "typography",
    "h1": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 600,
        "fontSize": {
          "value": 64,
          "unit": "px"
        },
        "lineHeight": 1,
        "letterSpacing": {
          "value": -2.24,
          "unit": "px"
        }
      },
      "$description": "Web range 36-96px. Sentence case, left aligned. Colour: text"
    },
    "h2": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontWeight": 600,
        "fontSize": {
          "value": 24,
          "unit": "px"
        },
        "lineHeight": 1.2,
        "letterSpacing": {
          "value": -0.48,
          "unit": "px"
        }
      },
      "$description": "Web range 20.8-28px. Sentence case"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontWeight": 400,
        "fontSize": {
          "value": 17,
          "unit": "px"
        },
        "lineHeight": 1.6,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Web range 16-18px. Colour: text or muted"
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontWeight": 400,
        "fontSize": {
          "value": 11.2,
          "unit": "px"
        },
        "lineHeight": 1.4,
        "letterSpacing": {
          "value": 1.12,
          "unit": "px"
        }
      },
      "$description": "0.7rem with 0.1em tracking. UPPER CASE. Colour: muted"
    },
    "button": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontWeight": 400,
        "fontSize": {
          "value": 12.8,
          "unit": "px"
        },
        "lineHeight": 1,
        "letterSpacing": {
          "value": 1.02,
          "unit": "px"
        }
      },
      "$description": "0.8rem with 0.08em tracking. UPPER CASE"
    },
    "bigStat": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontWeight": 400,
        "fontSize": {
          "value": 48,
          "unit": "px"
        },
        "lineHeight": 1.05,
        "letterSpacing": {
          "value": 0,
          "unit": "px"
        }
      },
      "$description": "Web range 32-56px. Tabular numerals. Colour: text"
    }
  },
  "size": {
    "$type": "dimension",
    "gutter": {
      "$value": {
        "value": 12,
        "unit": "px"
      },
      "$description": "Minimum side space on phones. Web range 12-48px"
    },
    "lineWidth": {
      "$value": {
        "value": 1,
        "unit": "px"
      }
    },
    "cornerRadius": {
      "$value": {
        "value": 0,
        "unit": "px"
      },
      "$description": "Square corners everywhere"
    },
    "touchTargetIOS": {
      "$value": {
        "value": 44,
        "unit": "px"
      },
      "$description": "44x44 pt minimum"
    },
    "touchTargetAndroid": {
      "$value": {
        "value": 48,
        "unit": "px"
      },
      "$description": "48x48 dp minimum"
    },
    "nzMark": {
      "$value": {
        "value": 22,
        "unit": "px"
      },
      "$description": "Southern Cross height (width 17.6px, viewBox 24x30), beside 'Aotearoa New Zealand'"
    },
    "shellMax": {
      "$value": {
        "value": 2400,
        "unit": "px"
      },
      "$description": "Page shell cap, 150rem. Pages use the full width below this"
    },
    "panelGap": {
      "$value": {
        "value": 16,
        "unit": "px"
      },
      "$description": "Space between panels. Web range 8-16px"
    },
    "panelPad": {
      "$value": {
        "value": 24,
        "unit": "px"
      },
      "$description": "Space inside panels. Web range 16-28px"
    },
    "fieldPitch": {
      "$value": {
        "value": 14,
        "unit": "px"
      },
      "$description": "Static pattern's cell spacing. The live field usually chooses 9-22px, to fit its wordmark and budget"
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "2": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "3": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "4": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "6": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "8": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    },
    "12": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "16": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "motion": {
    "entrance": {
      "duration": {
        "$type": "duration",
        "$value": {
          "value": 500,
          "unit": "ms"
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "$value": [
          0,
          0,
          0.58,
          1
        ],
        "$description": "ease-out"
      },
      "offsetY": {
        "$type": "dimension",
        "$value": {
          "value": 8,
          "unit": "px"
        },
        "$description": "Fade up from 8px below, opacity 0 to 1, once"
      }
    },
    "field": {
      "activeFps": {
        "$type": "number",
        "$value": 30,
        "$description": "While the water is moving"
      },
      "ambientFps": {
        "$type": "number",
        "$value": 20,
        "$description": "Slow swell with a recent pointer"
      },
      "idleFps": {
        "$type": "number",
        "$value": 10,
        "$description": "After 30s with no pointer"
      },
      "maxCells": {
        "$type": "number",
        "$value": 9000
      },
      "maxBackingPixels": {
        "$type": "number",
        "$value": 2100000
      }
    },
    "reduceMotion": {
      "$description": "When the OS asks for reduced motion, disable the entrance and draw the field as one still frame that ignores the pointer"
    }
  }
}
