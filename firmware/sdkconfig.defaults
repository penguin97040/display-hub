# Settings for the official firmware. Everything not set here keeps ESP-IDF v5.5.6's default.
# The build makes its full sdkconfig from this file, in the build folder (see CMakeLists.txt).

# --- Chip, flash and PSRAM ---
CONFIG_IDF_TARGET="esp32s3"
# The V2 board reports 16 MB of flash. The layout needs all of it (two 6 MiB app slots).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Quad I/O flash, as Waveshare's own ESP-IDF examples for this board use.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# The chip is an ESP32-S3R8: 8 MB of octal PSRAM in the package. Octal mode at 80 MHz, as
# Waveshare's examples set it. The screen's frame buffers will live here.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# --- Tasks ---
# app_main draws the first screen itself (lv_refr_now), and LVGL's software drawing needs far more
# than the default 3.5 KB of stack: the first board test overflowed it. 8 KB, as the LVGL task has.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- Partitions and updates ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
# A new image boots once on trial; if it isn't marked good, the bootloader goes back to the old one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# No eFuse anti-rollback: the security floor is kept in NVS instead (see docs/firmware-updates.md).
# CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK is not set

# --- Security features that stay off (see docs/firmware-handoff.md, "Storage and NVS") ---
# CONFIG_SECURE_BOOT is not set
# CONFIG_SECURE_FLASH_ENC_ENABLED is not set

# --- NVS encryption (see docs/firmware-handoff.md, "Storage and NVS") ---
# NVS is encrypted with the HMAC scheme: its keys are worked out at start-up by the chip's HMAC
# unit, from a secret key in eFuse key block KEY5. Never change the block between releases: a
# different block means a different key, and NVS written with the old one can't be read.
# With these on, ESP-IDF's nvs_flash_init() burns a new key into an empty KEY5 without asking,
# whatever state the chip is in. The firmware never calls it: main/storage_key.c looks at the
# eFuses first, and makes the key itself only on a new board whose KEY5 is empty, when that
# board's first setup arrives over USB. Both NVS partitions (partitions.csv) use this one key.
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_HMAC=y
CONFIG_NVS_SEC_HMAC_EFUSE_KEY_ID=5

# --- Build ---
# The same source and tools give the same image: no build date, time or local paths in it.
CONFIG_APP_REPRODUCIBLE_BUILD=y

# --- Console ---
# Logs and the USB setup exchange go over the chip's own USB port (USB-Serial-JTAG), which is what
# the board's USB-C socket was seen to use (docs/firmware-handoff.md, "Lessons from a real board").
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- Wi-Fi ---
# The Wi-Fi driver must never keep the network's name and password in its own NVS namespace: a
# factory reset erases only this firmware's setup partition, so they would outlive it. The
# firmware hands them to the driver from its own encrypted setup at each start (main/wifi.c).
# CONFIG_ESP_WIFI_NVS_ENABLED is not set
# A display only ever joins a network. It is never an access point.
# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set
# A hub address such as raspberrypi.local is looked up with a one-shot mDNS query by lwIP's own
# resolver, which esp_http_client uses. This is ESP-IDF's default; it is set here because finding
# the hub by name depends on it.
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=y

# --- TLS (see docs/firmware-handoff.md, "TLS, exactly") ---
# Lets main/hub_http.c hand ESP-IDF's HTTP client a connection of its own making, which keeps a
# time limit on the TLS handshake and the answer's headers and can be stopped by a factory reset.
# The client's built-in connection can do neither (the top of hub_http.c says why).
CONFIG_ESP_HTTP_CLIENT_ENABLE_CUSTOM_TRANSPORT=y
# The hub's records are at most 4 KiB, so a 4 KiB receive buffer is enough (the default is 16 KiB).
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# TLS 1.2 and 1.3 are both allowed by the hub.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
# The hub's key, and firmware signatures, are ECDSA on P-256.
CONFIG_MBEDTLS_ECP_C=y
CONFIG_MBEDTLS_ECDH_C=y
CONFIG_MBEDTLS_ECDSA_C=y
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=y
# The hub prefers AES-256-GCM.
CONFIG_MBEDTLS_GCM_C=y
# The hub's own certificate is the only trust anchor, so the bundle of public authorities is left
# out. It saves flash, and nothing can fall back to it by mistake.
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE is not set

# --- Components ---
# esp_codec_dev (pulled in by the board package) can link a prebuilt library for a ZL38063 voice
# chip. This board has no such chip, so keep it out.
# CONFIG_CODEC_ZL38063_SUPPORT is not set

# --- Screen (LVGL 9) ---
# LVGL takes its memory from main/ui_font.c (LV_USE_CUSTOM_MALLOC): PSRAM first, then any memory.
# Its own fixed 64 KB pool would sit in internal memory whether it was used or not, and Wi-Fi and
# TLS need internal memory (Mbed TLS is kept to it: CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC, ESP-IDF's
# default). The C library's malloc would put LVGL's many small blocks (widgets, glyphs) in
# internal memory too. The screen's draw buffers don't come from here (main/board/board.c).
CONFIG_LV_USE_CUSTOM_MALLOC=y
# The screens draw Geist, the desktop app's font, from its TrueType files with LVGL's built-in
# Tiny TTF (stb_truetype), so any size can be drawn and every character Geist has is there,
# macrons included. The files are built into the app (main/CMakeLists.txt); nothing is read from
# a file system.
CONFIG_LV_USE_TINY_TTF=y
# CONFIG_LV_TINY_TTF_FILE_SUPPORT is not set
# A character a font lacks is drawn as a hollow box, so it is plain that something is missing.
CONFIG_LV_USE_FONT_PLACEHOLDER=y
# LVGL needs one built-in font as its default. It only shows if a Geist size couldn't be made.
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y
# CONFIG_LV_FONT_MONTSERRAT_14 is not set
# Dark is the starting point for anything not styled by hand: black pixels are off on an AMOLED.
CONFIG_LV_THEME_DEFAULT_DARK=y
# LVGL's own examples aren't used, so don't compile them.
# CONFIG_LV_BUILD_EXAMPLES is not set
