{
  "id": "usage-limits/1",
  "name": "Usage limits",
  "description": "How much of a subscription's allowance you have used, as a bar for each of its windows (five-hour, weekly and, for OpenCode Go Plus, monthly).",
  "settings": [
    {
      "key": "service",
      "label": "Service",
      "type": "choice",
      "required": true,
      "default": "claude-max",
      "options": [
        { "value": "claude-max", "label": "Claude Max" },
        { "value": "chatgpt-plus", "label": "ChatGPT Plus" },
        { "value": "opencode-go-plus", "label": "OpenCode Go Plus" }
      ]
    },
    {
      "key": "source",
      "label": "Figures from",
      "help": "The PC helper can report Claude Max (from Claude Code) and ChatGPT Plus (from Codex). Nothing reports OpenCode Go Plus, so type its figures in.",
      "type": "choice",
      "required": true,
      "default": "manual",
      "options": [
        { "value": "manual", "label": "Typed in" },
        { "value": "helper", "label": "PC helper", "when": { "service": ["claude-max", "chatgpt-plus"] } },
        { "value": "demo", "label": "Demo figures" },
        { "value": "none", "label": "Nothing yet" }
      ]
    },
    {
      "key": "title",
      "label": "Title",
      "help": "Leave blank to use the service's name.",
      "type": "text",
      "max_length": 48
    }
  ],
  "pages": [
    { "title": "{title|service.label}", "kind": "meter", "source": "{source}", "feed": "{service}" }
  ]
}
