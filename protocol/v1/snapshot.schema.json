{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:display-hub:protocol:v1:dashboard-snapshot",
  "title": "Display Hub dashboard snapshot, protocol v1",
  "description": "What a hub sends. Displays must ignore fields they don't know, treat an unknown data_quality as unavailable, and show a page they can't use (unknown kind, bad data, over 3072 bytes) as a \"can't show this\" card rather than refusing the snapshot; see docs/protocol-v1.md. Text must also be Unicode NFC, which JSON Schema can't express.",
  "type": "object",
  "required": [
    "protocol_version",
    "message_type",
    "generated_at",
    "refresh_after_seconds",
    "pages"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "message_type": {
      "const": "dashboard.snapshot"
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "refresh_after_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    },
    "pages": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind",
          "data_quality",
          "updated_at",
          "stale_after_seconds",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "$ref": "#/$defs/text",
            "maxLength": 48
          },
          "kind": {
            "description": "A ready-made shape (meter, big_number, text or list), or a custom kind such as nearby-flights/1. The version is part of a custom kind.",
            "oneOf": [
              {
                "enum": [
                  "meter",
                  "big_number",
                  "text",
                  "list"
                ]
              },
              {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)*/[1-9][0-9]{0,3}$"
              }
            ]
          },
          "data_quality": {
            "enum": [
              "demo",
              "provider_reported",
              "estimated",
              "manual",
              "unavailable"
            ]
          },
          "updated_at": {
            "oneOf": [
              {
                "$ref": "#/$defs/timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "stale_after_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 604800
          },
          "note": {
            "oneOf": [
              {
                "$ref": "#/$defs/text",
                "maxLength": 96
              },
              {
                "type": "null"
              }
            ]
          },
          "data": {
            "description": "Absent (or null) when the page is unavailable, an object otherwise. Its shape follows kind. A custom kind's data is any object, nested at most 8 levels deep; the schema can't express the depth or the 3072-byte page limit, which the hub also checks.",
            "type": [
              "object",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "data_quality": {
                  "const": "unavailable"
                }
              }
            },
            "then": {
              "properties": {
                "data": {
                  "type": "null"
                }
              }
            },
            "else": {
              "required": [
                "data"
              ],
              "properties": {
                "data": {
                  "type": "object"
                },
                "updated_at": {
                  "$ref": "#/$defs/timestamp"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "meter"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "properties": {
                      "data": {
                        "$ref": "#/$defs/meter"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "big_number"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "properties": {
                      "data": {
                        "$ref": "#/$defs/big_number"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "text"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "properties": {
                      "data": {
                        "$ref": "#/$defs/text_data"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "list"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "properties": {
                      "data": {
                        "$ref": "#/$defs/list"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff](?:[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]*[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff])?$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "meter": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "percent"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "$ref": "#/$defs/text",
                "maxLength": 48
              },
              "percent": {
                "oneOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "resets_at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        }
      }
    },
    "big_number": {
      "type": "object",
      "required": [
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "unit": {
          "$ref": "#/$defs/text",
          "maxLength": 8
        },
        "caption": {
          "$ref": "#/$defs/text",
          "maxLength": 48
        }
      }
    },
    "text_data": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "$ref": "#/$defs/text",
          "maxLength": 280
        }
      }
    },
    "list": {
      "type": "object",
      "required": [
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "text": {
                "$ref": "#/$defs/text",
                "maxLength": 48
              },
              "detail": {
                "$ref": "#/$defs/text",
                "maxLength": 48
              }
            }
          }
        }
      }
    }
  }
}
