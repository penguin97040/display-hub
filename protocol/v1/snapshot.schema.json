{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:display-hub:protocol:v1:dashboard-snapshot",
  "title": "Display Hub dashboard snapshot, protocol v1",
  "description": "What a hub sends. Displays must ignore fields they don't know and treat an unknown data_quality as unavailable; see docs/protocol-v1.md. Text must also be Unicode NFC, which JSON Schema can't express.",
  "type": "object",
  "required": [
    "protocol_version",
    "message_type",
    "dashboard_id",
    "generated_at",
    "refresh_after_seconds",
    "pages"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "message_type": {
      "const": "dashboard.snapshot"
    },
    "dashboard_id": {
      "const": "llm-usage"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "refresh_after_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    },
    "pages": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "data_quality",
          "updated_at",
          "stale_after_seconds",
          "note",
          "metrics"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 48,
            "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff](?:[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]*[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff])?$"
          },
          "data_quality": {
            "enum": [
              "demo",
              "provider_reported",
              "estimated",
              "manual",
              "unavailable"
            ]
          },
          "updated_at": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "stale_after_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 604800
          },
          "note": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 96,
                "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff](?:[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]*[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff])?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "metrics": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "used_percent",
                "resets_at"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 48,
                  "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff](?:[^\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff]*[^\\s\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u2069\\ufeff])?$"
                },
                "used_percent": {
                  "oneOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "resets_at": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "data_quality": {
                  "const": "unavailable"
                }
              }
            },
            "then": {
              "properties": {
                "metrics": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "updated_at": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                }
              }
            }
          }
        ]
      }
    }
  }
}
