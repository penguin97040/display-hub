{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:display-hub:protocol:v1:firmware-report",
  "title": "POST /v1/device/firmware/report request body",
  "description": "What became of a firmware offer. Sent when the display starts downloading, and when the offer is settled (repeated until the hub answers). A hub treats a state or reason it doesn't know as a failure. See docs/firmware-updates.md.",
  "type": "object",
  "required": [
    "offer_id",
    "state"
  ],
  "additionalProperties": false,
  "properties": {
    "offer_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "state": {
      "enum": [
        "downloading",
        "installed",
        "refused",
        "failed",
        "rolled_back"
      ]
    },
    "reason": {
      "description": "For refused: no_trusted_keys to downgrade. For failed: download, image_hash or flash. Absent otherwise.",
      "enum": [
        "no_trusted_keys",
        "too_large",
        "bad_format",
        "untrusted_key",
        "bad_signature",
        "wrong_device_type",
        "wrong_hardware",
        "downgrade",
        "download",
        "image_hash",
        "flash"
      ]
    },
    "firmware_version": {
      "description": "What the display is running as it sends the report.",
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f](?:[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\s\\u0000-\\u001f\\u007f-\\u009f])?$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "refused"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "enum": [
              "no_trusted_keys",
              "too_large",
              "bad_format",
              "untrusted_key",
              "bad_signature",
              "wrong_device_type",
              "wrong_hardware",
              "downgrade"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "enum": [
              "download",
              "image_hash",
              "flash"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "downloading",
              "installed",
              "rolled_back"
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "reason"
          ]
        }
      }
    }
  ]
}
