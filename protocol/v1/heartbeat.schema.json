{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:display-hub:protocol:v1:heartbeat",
  "title": "POST /v1/device/heartbeat request body",
  "description": "Also the `device` object in an enrolment request.",
  "type": "object",
  "required": [
    "device_type",
    "firmware_version",
    "hardware_revision",
    "protocol_version"
  ],
  "additionalProperties": false,
  "properties": {
    "device_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f](?:[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\s\\u0000-\\u001f\\u007f-\\u009f])?$"
    },
    "firmware_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f](?:[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\s\\u0000-\\u001f\\u007f-\\u009f])?$"
    },
    "hardware_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f](?:[^\\u0000-\\u001f\\u007f-\\u009f]*[^\\s\\u0000-\\u001f\\u007f-\\u009f])?$"
    },
    "protocol_version": {
      "type": "integer",
      "minimum": 1
    },
    "firmware": {
      "description": "Signed firmware updates: the display's trusted keys, security floor and spare app partition. Optional: firmware made before signed updates leaves it out. See docs/firmware-updates.md, 'What a display reports'.",
      "type": "object",
      "required": [
        "key_ids",
        "security_floor",
        "slot_bytes"
      ],
      "properties": {
        "key_ids": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "security_floor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "slot_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
